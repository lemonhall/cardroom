# 把这份文件复制成 .env 再跑 `npm run setup`。
#
# 这里的每一项都属于**服务端**：`.env` 只在网关这台机器上读，
# 浏览器一个密钥都拿不到（这正是这个 demo 想给你看的东西之一）。

# Muster 后端地址。本地 `wrangler dev` 默认监听 8787
# （`npm run dev` 不带 --port 时 wrangler 用 8787；E2E 才显式用 8788/8789）。
MUSTER_BASE=http://127.0.0.1:8787

# 牌室这一侧的服务端口。
CARDROOM_PORT=5173

# Muster 的 checkout 位置（`npm run setup` 要用它执行本地 D1 的迁移与播种）。
MUSTER_DIR=../muster

# 平台侧的名字：运行时模块名与排行榜 id。
CARDROOM_MODULE=blackjack
CARDROOM_LEADERBOARD=cardroom-net

# 下面两项**留空**，`npm run setup` 会生成好再写回本文件。
# 一个租户 = 一个游戏：server key 是这个游戏的"服务端口令"。
CARDROOM_TENANT_ID=
CARDROOM_SERVER_KEY=
